# DATABASE_URL from Neon (required for web + migrations)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Shared secret for the private research tool
ADMIN_KEY=change-me-to-a-long-random-string

# Optional — raises GitHub API rate limits (recommended for Phase 2)
# Create at https://github.com/settings/tokens (classic, public_repo read is enough for public repos)
GITHUB_TOKEN=

